[Unit]
Description=BAS-IP AA-14FB Automated PIN Rotator Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Change-pin-BasIpAERO
ExecStart=/usr/bin/python3 /opt/Change-pin-BasIpAERO/main.py daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
